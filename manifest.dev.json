{
  "manifest_version": 3,
  "name": "Gastly",
  "version": "0.0.0",
  "description": "Real-time Ethereum gas prices, transaction fee estimates, and spot prices - delivering fresh, high-quality signals as blocks arrive",
  "action": {
    "default_popup": "index.html",
    "default_title": "Gastly Ethereum Extension",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage", "alarms"]
}
